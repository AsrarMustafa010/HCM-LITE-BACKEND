# HCM Lite Backend Environment Variables Template

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection Strings
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.hwutoag.mongodb.net/hcm_lite?retryWrites=true&w=majority
MONGO_URI_DIRECT=mongodb://<username>:<password>@ac-hbkfv2j-shard-00-00.hwutoag.mongodb.net:27017,ac-hbkfv2j-shard-00-01.hwutoag.mongodb.net:27017,ac-hbkfv2j-shard-00-02.hwutoag.mongodb.net:27017/hcm_lite?ssl=true&replicaSet=atlas-wakezc-shard-0&authSource=admin

# JWT Authentication
JWT_SECRET=hcm_lite_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# Nodemailer Email Credentials (for Welcome Password & Password Reset OTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary (for employee profile photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Providers (Groq / Gemini for Smart Leave NLP, Workforce Insights & Chat)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend.vercel.app
